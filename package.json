{
  "name": "sportstracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "publish:production": "sh scripts/publish.sh",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit && node --experimental-sqlite --import tsx --test test/*.test.ts",
    "test": "node --experimental-sqlite --import tsx --test test/*.test.ts",
    "daily": "node --experimental-sqlite --import tsx src/main.ts",
    "preview": "node --experimental-sqlite --import tsx src/main.ts --dry-run --fixtures test/fixtures/cbv --date 2026-10-26",
    "start": "node --experimental-sqlite dist/main.js",
    "university": "node --experimental-sqlite --import tsx src/main.ts --university",
    "preview:university": "npm run university -- --dry-run --fixtures test/fixtures/university --date 2026-10-30"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^18.0.8",
    "luxon": "^3.7.2",
    "nodemailer": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
